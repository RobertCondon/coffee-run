# Copy to .env.local and fill in. `go run ./cmd/server` reads .env.local.

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=          # confidential clients only
# AUTH0_REFRESH_TOKEN=          # only for seeding an empty auth0_token table

# GET https://$QR_DOMAIN/api/qr/payload (bare host, no https://)
QR_DOMAIN=
